{
  "name": "uk-gov-service-graph-poc",
  "version": "1.0.0",
  "description": "Proof-of-concept service graph and MCP server for UK government life events",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-index.ts",
    "mcp": "tsx src/graph-server.ts",
    "verify:tier1": "tsx scripts/verify-tier1.ts --write",
    "verify:tier2": "tsx scripts/verify-tier2.ts --write",
    "verify:deadlines": "tsx scripts/verify-tier2-llm.ts --write",
    "check:types": "tsc --noEmit",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:provenance:online": "tsx scripts/check-provenance.ts --online",
    "build:lambda": "esbuild ./src/lambda-handler.ts --bundle --platform=node --target=node20 --outfile=dist/lambda-handler.js && esbuild ./src/graph-server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/graph-server.mjs",
    "package": "npm run build:lambda && zip -r function.zip dist/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@aws/run-mcp-servers-with-aws-lambda": "^0.5.19",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
